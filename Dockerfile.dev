FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN pip install --no-cache-dir \
    'aiogram>=3.15,<4' \
    'httpx>=0.27' \
    'pydantic>=2.9' \
    'pydantic-settings>=2.5' \
    'watchfiles>=0.24'

COPY pyproject.toml ./
COPY src ./src

WORKDIR /app
CMD ["watchfiles", "--filter", "python", "python src/main.py", "src"]
