TELEGRAM_BOT_TOKEN=
# Outside Docker: http://localhost:5000
# Inside Docker (same machine as mimir-api): http://host.docker.internal:5000
API_URL=http://host.docker.internal:5000
TELEGRAM_ALLOWED_USER_ID=
API_EMAIL=
API_PASSWORD=

# polling (default) | webhook
BOT_MODE=polling
# WEBHOOK_URL=https://example.com
# WEBHOOK_PATH=/webhook
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8080
API_TIMEOUT_SECONDS=15
BOT_TIMEZONE=America/Sao_Paulo
